{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account and role mapping isolated from employee directory.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 150
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["admin", "employee"]
        },
        "employeeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "role", "employeeId", "createdAt", "updatedAt"]
    },
    "TestConnectionDoc": {
      "title": "TestConnectionDoc",
      "description": "Firestore connectivity verification document.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "status", "updatedAt"]
    },
    "AppSettingsDoc": {
      "title": "AppSettingsDoc",
      "description": "Company identity, shift schedule configuration, and company profile.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "companyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "companySubtitle": {
          "type": "string",
          "maxLength": 120
        },
        "lateDeductionPerMinute": {
          "type": "number"
        },
        "shiftCount": {
          "type": "number"
        },
        "shifts": {
          "type": "array",
          "description": "Native list of shift configuration objects (max 20 items)."
        },
        "companyProfile": {
          "type": "object",
          "description": "Native map storing legal identity, leadership, and branch offices (max 30 branches)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "companyName",
        "companySubtitle",
        "lateDeductionPerMinute",
        "shiftCount",
        "shifts",
        "companyProfile",
        "updatedAt"
      ]
    },
    "Employee": {
      "title": "Employee",
      "description": "Employee work profile and individual weekly/custom off-day schedule.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "employeeCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "department": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "position": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "shiftName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "shiftStart": {
          "type": "string",
          "maxLength": 5,
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "shiftEnd": {
          "type": "string",
          "maxLength": 5,
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "offDays": {
          "type": "array",
          "description": "Weekly off-day indices (0=Minggu .. 6=Sabtu), max 7 items."
        },
        "customOffDates": {
          "type": "array",
          "description": "Specific YYYY-MM-DD off-dates override, max 31 items."
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "employeeCode",
        "name",
        "department",
        "position",
        "shiftName",
        "shiftStart",
        "shiftEnd",
        "offDays",
        "customOffDates",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Matrix attendance log including overtime hours and late-arrival permit fields.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "employeeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "employeeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": {
          "type": "string",
          "enum": ["hadir", "terlambat", "izin_terlambat", "izin", "sakit", "alpha", "libur"]
        },
        "checkIn": {
          "type": "string",
          "maxLength": 5,
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$|^$"
        },
        "checkOut": {
          "type": "string",
          "maxLength": 5,
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$|^$"
        },
        "overtimeHours": {
          "type": "number"
        },
        "entryType": {
          "type": "string",
          "enum": ["manual_karyawan", "manual_admin"]
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        },
        "latePermitReason": {
          "type": "string",
          "maxLength": 200
        },
        "latePermitEstimatedArrival": {
          "type": "string",
          "maxLength": 5,
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$|^$"
        },
        "latePermitApprovedBy": {
          "type": "string",
          "maxLength": 100
        },
        "recordedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "employeeId",
        "employeeName",
        "userId",
        "date",
        "status",
        "checkIn",
        "checkOut",
        "overtimeHours",
        "entryType",
        "notes",
        "latePermitReason",
        "latePermitEstimatedArrival",
        "latePermitApprovedBy",
        "recordedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "LateSettlementDoc": {
      "title": "LateSettlementDoc",
      "description": "Employee late compensation or deduction settlement record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "employeeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "employeeName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "yearMonth": { "type": "string", "maxLength": 7, "pattern": "^\\d{4}-\\d{2}$" },
        "date": { "type": "string", "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "method": { "type": "string", "enum": ["tambahan_jam_kerja", "potongan_gaji"] },
        "minutesSettled": { "type": "number" },
        "extraWorkStart": { "type": "string", "maxLength": 5, "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$|^$" },
        "extraWorkEnd": { "type": "string", "maxLength": 5, "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$|^$" },
        "deductionAmount": { "type": "number" },
        "notes": { "type": "string", "maxLength": 300 },
        "recordedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "employeeId",
        "employeeName",
        "yearMonth",
        "date",
        "method",
        "minutesSettled",
        "extraWorkStart",
        "extraWorkEnd",
        "deductionAmount",
        "notes",
        "recordedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "PayrollSettingsDoc": {
      "title": "PayrollSettingsDoc",
      "description": "Global payroll policy rates, BPJS percentages, and default payday.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "defaultOvertimeHourlyRate": { "type": "number" },
        "defaultAlphaDeductionPerDay": { "type": "number" },
        "defaultIzinDeductionPerDay": { "type": "number" },
        "autoDeductRemainingLate": { "type": "boolean" },
        "bpjsKesehatanPct": { "type": "number" },
        "bpjsKetenagakerjaanPct": { "type": "number" },
        "paydayDayOfMonth": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "defaultOvertimeHourlyRate",
        "defaultAlphaDeductionPerDay",
        "defaultIzinDeductionPerDay",
        "autoDeductRemainingLate",
        "bpjsKesehatanPct",
        "bpjsKetenagakerjaanPct",
        "paydayDayOfMonth",
        "updatedAt"
      ]
    },
    "PayrollProfileDoc": {
      "title": "PayrollProfileDoc",
      "description": "Confidential employee salary structure and bank account profile.",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "baseSalary": { "type": "number" },
        "positionAllowance": { "type": "number" },
        "transportMealAllowance": { "type": "number" },
        "otherAllowance": { "type": "number" },
        "overtimeHourlyRate": { "type": "number" },
        "paydayDay": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["transfer", "tunai"] },
        "bankName": { "type": "string", "maxLength": 60 },
        "bankAccountNumber": { "type": "string", "maxLength": 60 },
        "bankAccountHolder": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "employeeId",
        "baseSalary",
        "positionAllowance",
        "transportMealAllowance",
        "otherAllowance",
        "overtimeHourlyRate",
        "paydayDay",
        "paymentMethod",
        "bankName",
        "bankAccountNumber",
        "bankAccountHolder",
        "notes",
        "updatedAt"
      ]
    },
    "PayrollAdjustmentDoc": {
      "title": "PayrollAdjustmentDoc",
      "description": "Monthly payroll bonus, extra allowance, or deduction adjustment.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "employeeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "employeeName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "yearMonth": { "type": "string", "maxLength": 7, "pattern": "^\\d{4}-\\d{2}$" },
        "type": { "type": "string", "enum": ["bonus", "tunjangan", "potongan"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "amount": { "type": "number" },
        "date": { "type": "string", "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "notes": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "employeeId",
        "employeeName",
        "yearMonth",
        "type",
        "title",
        "amount",
        "date",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    },
    "PayrollRaiseDoc": {
      "title": "PayrollRaiseDoc",
      "description": "Employee salary raise history record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "employeeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "employeeName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "effectiveMonth": { "type": "string", "maxLength": 7, "pattern": "^\\d{4}-\\d{2}$" },
        "raiseDate": { "type": "string", "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "method": { "type": "string", "enum": ["nominal", "persentase"] },
        "percentIncrease": { "type": "number" },
        "previousBaseSalary": { "type": "number" },
        "newBaseSalary": { "type": "number" },
        "previousPositionAllowance": { "type": "number" },
        "newPositionAllowance": { "type": "number" },
        "previousTransportMealAllowance": { "type": "number" },
        "newTransportMealAllowance": { "type": "number" },
        "previousOtherAllowance": { "type": "number" },
        "newOtherAllowance": { "type": "number" },
        "reason": { "type": "string", "maxLength": 200 },
        "notes": { "type": "string", "maxLength": 300 },
        "appliedToProfile": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "employeeId",
        "employeeName",
        "effectiveMonth",
        "raiseDate",
        "method",
        "percentIncrease",
        "previousBaseSalary",
        "newBaseSalary",
        "previousPositionAllowance",
        "newPositionAllowance",
        "previousTransportMealAllowance",
        "newTransportMealAllowance",
        "previousOtherAllowance",
        "newOtherAllowance",
        "reason",
        "notes",
        "appliedToProfile",
        "createdAt",
        "updatedAt"
      ]
    },
    "PayrollStatusDoc": {
      "title": "PayrollStatusDoc",
      "description": "Monthly payroll approval and disbursement status per employee.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "employeeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "yearMonth": { "type": "string", "maxLength": 7, "pattern": "^\\d{4}-\\d{2}$" },
        "status": { "type": "string", "enum": ["draft", "disetujui", "dibayar"] },
        "paidAt": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "employeeId", "yearMonth", "status", "paidAt", "updatedAt"]
    },
    "FinanceAccountDoc": {
      "title": "FinanceAccountDoc",
      "description": "Company cash or bank account definition.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "kind": { "type": "string", "enum": ["cash", "rekening"] },
        "bankName": { "type": "string", "maxLength": 60 },
        "accountNumber": { "type": "string", "maxLength": 60 },
        "holderName": { "type": "string", "maxLength": 100 },
        "openingBalance": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "name",
        "kind",
        "bankName",
        "accountNumber",
        "holderName",
        "openingBalance",
        "createdAt",
        "updatedAt"
      ]
    },
    "FinanceCategoryDoc": {
      "title": "FinanceCategoryDoc",
      "description": "Income or expense category definition.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "type": { "type": "string", "enum": ["pendapatan", "pengeluaran"] },
        "description": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "type", "description", "createdAt", "updatedAt"]
    },
    "FinanceTransactionDoc": {
      "title": "FinanceTransactionDoc",
      "description": "Company financial income or expense transaction.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "type": { "type": "string", "enum": ["pendapatan", "pengeluaran"] },
        "method": { "type": "string", "enum": ["cash", "transfer"] },
        "categoryId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "categoryName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "accountId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 150 },
        "counterparty": { "type": "string", "maxLength": 100 },
        "bankAccount": { "type": "string", "maxLength": 120 },
        "referenceNo": { "type": "string", "maxLength": 50 },
        "amount": { "type": "number" },
        "notes": { "type": "string", "maxLength": 300 },
        "recordedBy": { "type": "string", "minLength": 1, "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "date",
        "type",
        "method",
        "categoryId",
        "categoryName",
        "accountId",
        "title",
        "counterparty",
        "bankAccount",
        "referenceNo",
        "amount",
        "notes",
        "recordedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "FinanceTransferDoc": {
      "title": "FinanceTransferDoc",
      "description": "Internal fund transfer between company cash and bank accounts.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "fromAccountId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fromAccountName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "toAccountId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "toAccountName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "amount": { "type": "number" },
        "referenceNo": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 300 },
        "recordedBy": { "type": "string", "minLength": 1, "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "date",
        "fromAccountId",
        "fromAccountName",
        "toAccountId",
        "toAccountName",
        "amount",
        "referenceNo",
        "notes",
        "recordedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "SecurityConfigDoc": {
      "title": "SecurityConfigDoc",
      "description": "SHA-256 hashes for Attendance Admin, Finance Admin, and Database Settings PINs.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adminPinSha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
        "attendancePinSha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
        "databasePinSha256": { "type": "string", "maxLength": 64, "pattern": "^[a-f0-9]{64}$|^$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "adminPinSha256", "databasePinSha256", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User authentication profile and role mapping (PII protected)."
    },
    "/test/{docId}": {
      "schema": { "$ref": "#/entities/TestConnectionDoc" },
      "description": "Firestore connectivity verification document."
    },
    "/appSettings/{settingId}": {
      "schema": { "$ref": "#/entities/AppSettingsDoc" },
      "description": "Company identity, shift schedule configuration, and profile metadata."
    },
    "/employees/{employeeId}": {
      "schema": { "$ref": "#/entities/Employee" },
      "description": "Active employee profiles and per-employee day-off schedules."
    },
    "/attendance/{recordId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Matrix employee attendance logs including late-arrival permits and overtime."
    },
    "/lateSettlements/{settlementId}": {
      "schema": { "$ref": "#/entities/LateSettlementDoc" },
      "description": "Employee late compensation and deduction settlements."
    },
    "/payrollSettings/{settingId}": {
      "schema": { "$ref": "#/entities/PayrollSettingsDoc" },
      "description": "Global payroll policy settings (admin-only)."
    },
    "/payrollProfiles/{employeeId}": {
      "schema": { "$ref": "#/entities/PayrollProfileDoc" },
