{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account and role mapping isolated from public employee roster.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 150
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["admin", "employee"]
        },
        "employeeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "role", "employeeId", "createdAt", "updatedAt"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Employee work profile and individual weekly day-off schedule without PII.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "employeeCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "department": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "position": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "shiftName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "shiftStart": {
          "type": "string",
          "maxLength": 5,
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "shiftEnd": {
          "type": "string",
          "maxLength": 5,
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "offDays": {
          "type": "array",
          "description": "Weekly off-day indices (0=Minggu .. 6=Sabtu), max 7 items."
        },
        "customOffDates": {
          "type": "array",
          "description": "Specific YYYY-MM-DD off-dates override, max 31 items."
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "employeeCode",
        "name",
        "department",
        "position",
        "shiftName",
        "shiftStart",
        "shiftEnd",
        "offDays",
        "customOffDates",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Manual employee attendance log entry.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "employeeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "employeeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": {
          "type": "string",
          "enum": ["hadir", "terlambat", "izin_terlambat", "izin", "sakit", "alpha", "libur"]
        },
        "checkIn": {
          "type": "string",
          "maxLength": 5,
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$|^$"
        },
        "checkOut": {
          "type": "string",
          "maxLength": 5,
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$|^$"
        },
        "entryType": {
          "type": "string",
          "enum": ["manual_karyawan", "manual_admin"]
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        },
        "recordedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "employeeId",
        "employeeName",
        "userId",
        "date",
        "status",
        "checkIn",
        "checkOut",
        "entryType",
        "notes",
        "recordedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "OvertimeRequest": {
      "title": "OvertimeRequest",
      "description": "Employee overtime request with approval workflow.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "employeeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "employeeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "startTime": {
          "type": "string",
          "maxLength": 5,
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "endTime": {
          "type": "string",
          "maxLength": 5,
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "durationHours": {
          "type": "number"
        },
        "reason": {
          "type": "string",
          "minLength": 5,
          "maxLength": 400
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected", "cancelled"]
        },
        "reviewedBy": {
          "type": "string",
          "maxLength": 128
        },
        "reviewNotes": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "employeeId",
        "employeeName",
        "userId",
        "date",
        "startTime",
        "endTime",
        "durationHours",
        "reason",
        "status",
        "reviewedBy",
        "reviewNotes",
        "createdAt",
        "updatedAt"
      ]
    },
    "LeaveRequest": {
      "title": "LeaveRequest",
      "description": "Employee leave, permission, or sick day request with approval workflow.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "employeeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "employeeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "leaveType": {
          "type": "string",
          "enum": ["cuti_tahunan", "izin_pribadi", "sakit", "izin_khusus"]
        },
        "startDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "endDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "totalDays": {
          "type": "number"
        },
        "reason": {
          "type": "string",
          "minLength": 5,
          "maxLength": 400
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected", "cancelled"]
        },
        "reviewedBy": {
          "type": "string",
          "maxLength": 128
        },
        "reviewNotes": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "employeeId",
        "employeeName",
        "userId",
        "leaveType",
        "startDate",
        "endDate",
        "totalDays",
        "reason",
        "status",
        "reviewedBy",
        "reviewNotes",
        "createdAt",
        "updatedAt"
      ]
    },
    "TestConnectionDoc": {
      "title": "TestConnectionDoc",
      "description": "Firestore connectivity check document.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "minLength": 1, "maxLength": 32 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "status", "updatedAt"]
    },
    "AppSettingsDoc": {
      "title": "AppSettingsDoc",
      "description": "Company general settings and shifts snapshot.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "companyName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "companySubtitle": { "type": "string", "maxLength": 120 },
        "lateDeductionPerMinute": { "type": "number" },
        "shiftCount": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyName", "companySubtitle", "lateDeductionPerMinute", "shiftCount", "updatedAt"]
    },
    "LateSettlementDoc": {
      "title": "LateSettlementDoc",
      "description": "Employee late compensation or deduction settlement record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "employeeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "employeeName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "yearMonth": { "type": "string", "maxLength": 7, "pattern": "^\\d{4}-\\d{2}$" },
        "date": { "type": "string", "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "method": { "type": "string", "enum": ["tambahan_jam_kerja", "potongan_gaji"] },
        "minutesSettled": { "type": "number" },
        "notes": { "type": "string", "maxLength": 300 },
        "recordedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "employeeId", "employeeName", "yearMonth", "date", "method", "minutesSettled", "notes", "recordedBy", "createdAt"]
    },
    "FinanceAccountDoc": {
      "title": "FinanceAccountDoc",
      "description": "Company cash or bank account definition.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "kind": { "type": "string", "enum": ["cash", "rekening"] },
        "bankName": { "type": "string", "maxLength": 60 },
        "accountNumber": { "type": "string", "maxLength": 60 },
        "holderName": { "type": "string", "maxLength": 100 },
        "openingBalance": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "kind", "bankName", "accountNumber", "holderName", "openingBalance", "updatedAt"]
    },
    "FinanceCategoryDoc": {
      "title": "FinanceCategoryDoc",
      "description": "Income or expense category definition.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "type": { "type": "string", "enum": ["pendapatan", "pengeluaran"] },
        "description": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "type", "description", "updatedAt"]
    },
    "FinanceTransactionDoc": {
      "title": "FinanceTransactionDoc",
      "description": "Company financial income or expense transaction.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "type": { "type": "string", "enum": ["pendapatan", "pengeluaran"] },
        "method": { "type": "string", "enum": ["cash", "transfer"] },
        "categoryId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "categoryName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "accountId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 150 },
        "amount": { "type": "number" },
        "notes": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "date", "type", "method", "categoryId", "categoryName", "accountId", "title", "amount", "notes", "updatedAt"]
    },
    "FinanceTransferDoc": {
      "title": "FinanceTransferDoc",
      "description": "Internal fund transfer between company cash and bank accounts.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "fromAccountId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fromAccountName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "toAccountId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "toAccountName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "amount": { "type": "number" },
        "notes": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "date", "fromAccountId", "fromAccountName", "toAccountId", "toAccountName", "amount", "notes", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User authentication profile and role mapping (PII protected)."
    },
    "/employees/{employeeId}": {
      "schema": { "$ref": "#/entities/Employee" },
      "description": "Active employee profiles and per-employee day-off schedules."
    },
    "/attendance/{recordId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Manual employee attendance logs."
    },
    "/overtimeRequests/{requestId}": {
      "schema": { "$ref": "#/entities/OvertimeRequest" },
      "description": "Employee overtime request records and approval statuses."
    },
    "/leaveRequests/{requestId}": {
      "schema": { "$ref": "#/entities/LeaveRequest" },
      "description": "Employee leave, permission, and sick request records."
    },
    "/test/{docId}": {
      "schema": { "$ref": "#/entities/TestConnectionDoc" },
      "description": "Connectivity verification document."
    },
    "/appSettings/{settingId}": {
      "schema": { "$ref": "#/entities/AppSettingsDoc" },
      "description": "Company settings and shift configuration metadata."
    },
    "/lateSettlements/{settlementId}": {
      "schema": { "$ref": "#/entities/LateSettlementDoc" },
      "description": "Employee late compensation settlements."
    },
    "/financeAccounts/{accountId}": {
      "schema": { "$ref": "#/entities/FinanceAccountDoc" },
      "description": "Company cash and bank accounts."
    },
    "/financeCategories/{categoryId}": {
      "schema": { "$ref": "#/entities/FinanceCategoryDoc" },
      "description": "Company finance income/expense categories."
    },
    "/financeTransactions/{transactionId}": {
      "schema": { "$ref": "#/entities/FinanceTransactionDoc" },
      "description": "Company financial transactions."
    },
    "/financeTransfers/{transferId}": {
      "schema": { "$ref": "#/entities/FinanceTransferDoc" },
      "description": "Internal transfers between cash and bank accounts."
    }
  }
}
