{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account and role mapping isolated from public employee roster.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 150
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["admin", "employee"]
        },
        "employeeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "role", "employeeId", "createdAt", "updatedAt"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Employee work profile and individual weekly day-off schedule without PII.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "employeeCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "department": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "position": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "shiftName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "shiftStart": {
          "type": "string",
          "maxLength": 5,
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "shiftEnd": {
          "type": "string",
          "maxLength": 5,
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "offDays": {
          "type": "array",
          "description": "Weekly off-day indices (0=Minggu .. 6=Sabtu), max 7 items."
        },
        "customOffDates": {
          "type": "array",
          "description": "Specific YYYY-MM-DD off-dates override, max 31 items."
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "employeeCode",
        "name",
        "department",
        "position",
        "shiftName",
        "shiftStart",
        "shiftEnd",
        "offDays",
        "customOffDates",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Manual employee attendance log entry.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "employeeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "employeeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": {
          "type": "string",
          "enum": ["hadir", "terlambat", "izin", "sakit", "alpha", "libur"]
        },
        "checkIn": {
          "type": "string",
          "maxLength": 5,
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$|^$"
        },
        "checkOut": {
          "type": "string",
          "maxLength": 5,
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$|^$"
        },
        "entryType": {
          "type": "string",
          "enum": ["manual_karyawan", "manual_admin"]
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        },
        "recordedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "employeeId",
        "employeeName",
        "userId",
        "date",
        "status",
        "checkIn",
        "checkOut",
        "entryType",
        "notes",
        "recordedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "OvertimeRequest": {
      "title": "OvertimeRequest",
      "description": "Employee overtime request with approval workflow.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "employeeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "employeeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "startTime": {
          "type": "string",
          "maxLength": 5,
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "endTime": {
          "type": "string",
          "maxLength": 5,
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "durationHours": {
          "type": "number"
        },
        "reason": {
          "type": "string",
          "minLength": 5,
          "maxLength": 400
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected", "cancelled"]
        },
        "reviewedBy": {
          "type": "string",
          "maxLength": 128
        },
        "reviewNotes": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "employeeId",
        "employeeName",
        "userId",
        "date",
        "startTime",
        "endTime",
        "durationHours",
        "reason",
        "status",
        "reviewedBy",
        "reviewNotes",
        "createdAt",
        "updatedAt"
      ]
    },
    "LeaveRequest": {
      "title": "LeaveRequest",
      "description": "Employee leave, permission, or sick day request with approval workflow.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "employeeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "employeeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "leaveType": {
          "type": "string",
          "enum": ["cuti_tahunan", "izin_pribadi", "sakit", "izin_khusus"]
        },
        "startDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "endDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "totalDays": {
          "type": "number"
        },
        "reason": {
          "type": "string",
          "minLength": 5,
          "maxLength": 400
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected", "cancelled"]
        },
        "reviewedBy": {
          "type": "string",
          "maxLength": 128
        },
        "reviewNotes": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "employeeId",
        "employeeName",
        "userId",
        "leaveType",
        "startDate",
        "endDate",
        "totalDays",
        "reason",
        "status",
        "reviewedBy",
        "reviewNotes",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User authentication profile and role mapping (PII protected)."
    },
    "/employees/{employeeId}": {
      "schema": { "$ref": "#/entities/Employee" },
      "description": "Active employee profiles and per-employee day-off schedules."
    },
    "/attendance/{recordId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Manual employee attendance logs."
    },
    "/overtimeRequests/{requestId}": {
      "schema": { "$ref": "#/entities/OvertimeRequest" },
      "description": "Employee overtime request records and approval statuses."
    },
    "/leaveRequests/{requestId}": {
      "schema": { "$ref": "#/entities/LeaveRequest" },
      "description": "Employee leave, permission, and sick request records."
    }
  }
}
