rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'assyfachanel99@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerified() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isValidDateStr(d) {
      return d is string && d.size() == 10 && d.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidYearMonthStr(ym) {
      return ym is string && ym.size() == 7 && ym.matches('^\\d{4}-\\d{2}$');
    }

    function isValidTimeStr(t) {
      return t is string && t.size() == 5 && t.matches('^([01]\\d|2[0-3]):[0-5]\\d$');
    }

    function isValidOptionalTimeStr(t) {
      return t is string && ((t.size() == 0) || (t.size() == 5 && t.matches('^([01]\\d|2[0-3]):[0-5]\\d$')));
    }

    // 3. Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'employeeId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'employeeId', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 150
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.role in ['admin', 'employee']
        && isValidId(data.employeeId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEmployee(data) {
      return data.keys().hasAll([
          'id', 'userId', 'employeeCode', 'name', 'department', 'position',
          'shiftName', 'shiftStart', 'shiftEnd', 'offDays', 'customOffDates',
          'active', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'employeeCode', 'name', 'department', 'position',
          'shiftName', 'shiftStart', 'shiftEnd', 'offDays', 'customOffDates',
          'active', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.employeeCode is string && data.employeeCode.size() >= 2 && data.employeeCode.size() <= 20 && data.employeeCode.matches('^[A-Z0-9\\-]+$')
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.department is string && data.department.size() >= 2 && data.department.size() <= 60
        && data.position is string && data.position.size() >= 2 && data.position.size() <= 60
        && data.shiftName is string && data.shiftName.size() >= 2 && data.shiftName.size() <= 40
        && isValidTimeStr(data.shiftStart)
        && isValidTimeStr(data.shiftEnd)
        && data.offDays is list && data.offDays.size() <= 7
        && (data.offDays.size() == 0 || (data.offDays[0] is int && data.offDays[0] >= 0 && data.offDays[0] <= 6))
        && data.customOffDates is list && data.customOffDates.size() <= 31
        && (data.customOffDates.size() == 0 || isValidDateStr(data.customOffDates[0]))
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAttendance(data) {
      return data.keys().hasAll([
          'id', 'employeeId', 'employeeName', 'userId', 'date', 'status',
          'checkIn', 'checkOut', 'entryType', 'notes', 'recordedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'employeeId', 'employeeName', 'userId', 'date', 'status',
          'checkIn', 'checkOut', 'entryType', 'notes', 'recordedBy', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.employeeId)
        && data.employeeName is string && data.employeeName.size() >= 2 && data.employeeName.size() <= 100
        && isValidId(data.userId)
        && isValidDateStr(data.date)
        && data.status in ['hadir', 'terlambat', 'izin_terlambat', 'izin', 'sakit', 'alpha', 'libur']
        && isValidOptionalTimeStr(data.checkIn)
        && isValidOptionalTimeStr(data.checkOut)
        && data.entryType in ['manual_karyawan', 'manual_admin']
        && data.notes is string && data.notes.size() <= 300
        && isValidId(data.recordedBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOvertimeRequest(data) {
      return data.keys().hasAll([
          'id', 'employeeId', 'employeeName', 'userId', 'date', 'startTime', 'endTime',
          'durationHours', 'reason', 'status', 'reviewedBy', 'reviewNotes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'employeeId', 'employeeName', 'userId', 'date', 'startTime', 'endTime',
          'durationHours', 'reason', 'status', 'reviewedBy', 'reviewNotes', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.employeeId)
        && data.employeeName is string && data.employeeName.size() >= 2 && data.employeeName.size() <= 100
        && isValidId(data.userId)
        && isValidDateStr(data.date)
        && isValidTimeStr(data.startTime)
        && isValidTimeStr(data.endTime)
        && (data.durationHours is int || data.durationHours is float) && data.durationHours >= 0.5 && data.durationHours <= 16
        && data.reason is string && data.reason.size() >= 5 && data.reason.size() <= 400
        && data.status in ['pending', 'approved', 'rejected', 'cancelled']
        && data.reviewedBy is string && data.reviewedBy.size() <= 128
        && data.reviewNotes is string && data.reviewNotes.size() <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLeaveRequest(data) {
      return data.keys().hasAll([
          'id', 'employeeId', 'employeeName', 'userId', 'leaveType', 'startDate', 'endDate',
          'totalDays', 'reason', 'status', 'reviewedBy', 'reviewNotes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'employeeId', 'employeeName', 'userId', 'leaveType', 'startDate', 'endDate',
          'totalDays', 'reason', 'status', 'reviewedBy', 'reviewNotes', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.employeeId)
        && data.employeeName is string && data.employeeName.size() >= 2 && data.employeeName.size() <= 100
        && isValidId(data.userId)
        && data.leaveType in ['cuti_tahunan', 'izin_pribadi', 'sakit', 'izin_khusus']
        && isValidDateStr(data.startDate)
        && isValidDateStr(data.endDate)
        && (data.totalDays is int || data.totalDays is float) && data.totalDays >= 1 && data.totalDays <= 60
        && data.reason is string && data.reason.size() >= 5 && data.reason.size() <= 400
        && data.status in ['pending', 'approved', 'rejected', 'cancelled']
        && data.reviewedBy is string && data.reviewedBy.size() <= 128
        && data.reviewNotes is string && data.reviewNotes.size() <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTestConnection(data) {
      return data.keys().hasAll(['id', 'status', 'updatedAt'])
        && data.keys().hasOnly(['id', 'status', 'updatedAt'])
        && isValidId(data.id)
        && data.status is string && data.status.size() >= 1 && data.status.size() <= 32
        && data.updatedAt is timestamp;
    }

    function isValidAppSettings(data) {
      return data.keys().hasAll(['id', 'companyName', 'companySubtitle', 'lateDeductionPerMinute', 'shiftCount', 'updatedAt'])
        && data.keys().hasOnly(['id', 'companyName', 'companySubtitle', 'lateDeductionPerMinute', 'shiftCount', 'updatedAt'])
        && isValidId(data.id)
        && data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 120
        && data.companySubtitle is string && data.companySubtitle.size() <= 120
        && (data.lateDeductionPerMinute is int || data.lateDeductionPerMinute is float) && data.lateDeductionPerMinute >= 0
        && (data.shiftCount is int || data.shiftCount is float) && data.shiftCount >= 0 && data.shiftCount <= 50
        && data.updatedAt is timestamp;
    }

    function isValidLateSettlement(data) {
      return data.keys().hasAll(['id', 'employeeId', 'employeeName', 'yearMonth', 'date', 'method', 'minutesSettled', 'notes', 'recordedBy', 'createdAt'])
        && data.keys().hasOnly(['id', 'employeeId', 'employeeName', 'yearMonth', 'date', 'method', 'minutesSettled', 'notes', 'recordedBy', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.employeeId)
        && data.employeeName is string && data.employeeName.size() >= 1 && data.employeeName.size() <= 100
        && isValidYearMonthStr(data.yearMonth)
        && isValidDateStr(data.date)
        && data.method in ['tambahan_jam_kerja', 'potongan_gaji']
        && (data.minutesSettled is int || data.minutesSettled is float) && data.minutesSettled >= 0
        && data.notes is string && data.notes.size() <= 300
        && data.recordedBy is string && data.recordedBy.size() >= 1 && data.recordedBy.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidFinanceAccount(data) {
      return data.keys().hasAll(['id', 'name', 'kind', 'bankName', 'accountNumber', 'holderName', 'openingBalance', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'kind', 'bankName', 'accountNumber', 'holderName', 'openingBalance', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.kind in ['cash', 'rekening']
        && data.bankName is string && data.bankName.size() <= 60
        && data.accountNumber is string && data.accountNumber.size() <= 60
        && data.holderName is string && data.holderName.size() <= 100
        && (data.openingBalance is int || data.openingBalance is float)
        && data.updatedAt is timestamp;
    }

    function isValidFinanceCategory(data) {
      return data.keys().hasAll(['id', 'name', 'type', 'description', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'type', 'description', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.type in ['pendapatan', 'pengeluaran']
        && data.description is string && data.description.size() <= 300
        && data.updatedAt is timestamp;
    }

    function isValidFinanceTransaction(data) {
      return data.keys().hasAll(['id', 'date', 'type', 'method', 'categoryId', 'categoryName', 'accountId', 'title', 'amount', 'notes', 'updatedAt'])
        && data.keys().hasOnly(['id', 'date', 'type', 'method', 'categoryId', 'categoryName', 'accountId', 'title', 'amount', 'notes', 'updatedAt'])
        && isValidId(data.id)
        && isValidDateStr(data.date)
        && data.type in ['pendapatan', 'pengeluaran']
        && data.method in ['cash', 'transfer']
        && isValidId(data.categoryId)
        && data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 100
        && isValidId(data.accountId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 150
        && (data.amount is int || data.amount is float) && data.amount >= 0
        && data.notes is string && data.notes.size() <= 300
        && data.updatedAt is timestamp;
    }

    function isValidFinanceTransfer(data) {
      return data.keys().hasAll(['id', 'date', 'fromAccountId', 'fromAccountName', 'toAccountId', 'toAccountName', 'amount', 'notes', 'updatedAt'])
        && data.keys().hasOnly(['id', 'date', 'fromAccountId', 'fromAccountName', 'toAccountId', 'toAccountName', 'amount', 'notes', 'updatedAt'])
        && isValidId(data.id)
        && isValidDateStr(data.date)
        && isValidId(data.fromAccountId)
        && data.fromAccountName is string && data.fromAccountName.size() >= 1 && data.fromAccountName.size() <= 100
        && isValidId(data.toAccountId)
        && data.toAccountName is string && data.toAccountName.size() >= 1 && data.toAccountName.size() <= 100
        && (data.amount is int || data.amount is float) && data.amount > 0
        && data.notes is string && data.notes.size() <= 300
        && data.updatedAt is timestamp;
    }

    // 4. Collection Rules

    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (isBootstrappedAdmin() || resource.data.uid == request.auth.uid);

      allow create: if isVerified()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isBootstrappedAdmin() ||
          (isOwner(userId) && incoming().role == 'employee')
        );

      allow update: if isVerified()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId) &&
            incoming().role == existing().role &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
          )
        );

      allow delete: if isValidId(userId) && isAdmin();
    }

    match /employees/{employeeId} {
      allow get: if isValidId(employeeId) && isSignedIn() && (resource == null || existing().active == true || existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (isBootstrappedAdmin() || resource.data.active == true);

      allow create: if isVerified()
        && isValidId(employeeId)
        && isValidEmployee(incoming())
        && incoming().id == employeeId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (incoming().userId == request.auth.uid && incoming().active == true)
        );

      allow update: if isVerified()
        && isValidId(employeeId)
        && isValidEmployee(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            incoming().userId == existing().userId &&
            incoming().diff(existing()).affectedKeys().hasOnly(['shiftName', 'shiftStart', 'shiftEnd', 'updatedAt'])
          )
        );

      allow delete: if isValidId(employeeId) && isAdmin();
    }

    match /attendance/{recordId} {
      allow get: if isValidId(recordId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (isBootstrappedAdmin() || resource.data.userId == request.auth.uid);

      allow create: if isVerified()
        && isValidId(recordId)
        && isValidAttendance(incoming())
        && incoming().id == recordId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/employees/$(incoming().employeeId))
        && (
          isAdmin() ||
          (
            incoming().userId == request.auth.uid &&
            incoming().recordedBy == request.auth.uid &&
            incoming().entryType == 'manual_karyawan'
          )
        );

      allow update: if isVerified()
        && isValidId(recordId)
        && isValidAttendance(incoming())
        && incoming().id == existing().id
        && incoming().employeeId == existing().employeeId
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            incoming().entryType == 'manual_karyawan' &&
            incoming().recordedBy == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['checkIn', 'checkOut', 'status', 'notes', 'recordedBy', 'updatedAt'])
          )
        );

      allow delete: if isValidId(recordId) && isAdmin();
    }

    match /overtimeRequests/{requestId} {
      allow get: if isValidId(requestId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (isBootstrappedAdmin() || resource.data.userId == request.auth.uid);

      allow create: if isVerified()
        && isValidId(requestId)
        && isValidOvertimeRequest(incoming())
        && incoming().id == requestId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/employees/$(incoming().employeeId))
        && (
          isAdmin() ||
          (
            incoming().userId == request.auth.uid &&
            incoming().status == 'pending' &&
            incoming().reviewedBy == '' &&
            incoming().reviewNotes == ''
          )
        );

      allow update: if isVerified()
        && isValidId(requestId)
        && isValidOvertimeRequest(incoming())
        && incoming().id == existing().id
        && incoming().employeeId == existing().employeeId
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            existing().status == 'pending' &&
            incoming().status == 'cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      allow delete: if isValidId(requestId) && isAdmin();
    }

    match /leaveRequests/{requestId} {
      allow get: if isValidId(requestId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (isBootstrappedAdmin() || resource.data.userId == request.auth.uid);

      allow create: if isVerified()
        && isValidId(requestId)
        && isValidLeaveRequest(incoming())
        && incoming().id == requestId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/employees/$(incoming().employeeId))
        && (
          isAdmin() ||
          (
            incoming().userId == request.auth.uid &&
            incoming().status == 'pending' &&
            incoming().reviewedBy == '' &&
            incoming().reviewNotes == ''
          )
        );

      allow update: if isVerified()
        && isValidId(requestId)
        && isValidLeaveRequest(incoming())
        && incoming().id == existing().id
        && incoming().employeeId == existing().employeeId
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            existing().status == 'pending' &&
            incoming().status == 'cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      allow delete: if isValidId(requestId) && isAdmin();
    }

    match /test/{docId} {
      allow get: if isValidId(docId) && isSignedIn();
      allow list: if isAdmin();
      allow create, update: if isValidId(docId)
        && docId == 'connection'
        && isAdmin()
        && isValidTestConnection(incoming())
        && incoming().id == docId
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /appSettings/{settingId} {
      allow get: if isValidId(settingId) && isAdmin();
      allow list: if isAdmin();
      allow create, update: if isValidId(settingId)
        && isAdmin()
        && isValidAppSettings(incoming())
        && incoming().id == settingId
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /lateSettlements/{settlementId} {
      allow get: if isValidId(settlementId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(settlementId)
        && isAdmin()
        && isValidLateSettlement(incoming())
        && incoming().id == settlementId
        && incoming().createdAt == request.time;
      allow update: if isValidId(settlementId)
        && isAdmin()
        && isValidLateSettlement(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(settlementId) && isAdmin();
    }

    match /financeAccounts/{accountId} {
      allow get: if isValidId(accountId) && isAdmin();
      allow list: if isAdmin();
      allow create, update: if isValidId(accountId)
        && isAdmin()
        && isValidFinanceAccount(incoming())
        && incoming().id == accountId
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(accountId) && isAdmin();
    }

    match /financeCategories/{categoryId} {
      allow get: if isValidId(categoryId) && isAdmin();
      allow list: if isAdmin();
      allow create, update: if isValidId(categoryId)
        && isAdmin()
        && isValidFinanceCategory(incoming())
        && incoming().id == categoryId
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    match /financeTransactions/{transactionId} {
      allow get: if isValidId(transactionId) && isAdmin();
      allow list: if isAdmin();
      allow create, update: if isValidId(transactionId)
        && isAdmin()
        && isValidFinanceTransaction(incoming())
        && incoming().id == transactionId
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(transactionId) && isAdmin();
    }

    match /financeTransfers/{transferId} {
      allow get: if isValidId(transferId) && isAdmin();
      allow list: if isAdmin();
      allow create, update: if isValidId(transferId)
        && isAdmin()
        && isValidFinanceTransfer(incoming())
        && incoming().id == transferId
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(transferId) && isAdmin();
    }
  }
}
